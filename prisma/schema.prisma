// Marcaworld - Prisma + PostgreSQL veritabanı şeması
// Çalıştırmak için: npx prisma migrate dev --name init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ---------- YÖNETİM PANELİ KULLANICILARI ----------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
}

// ---------- ÜLKELER (şirket kuruluşu yapılan ülkeler) ----------
model Country {
  id          String    @id @default(cuid())
  slug        String    @unique // "hu", "uk", "us" ...
  flag        String    // emoji
  name        String    // "Macaristan"
  entity      String    // "Kft. şirket kuruluşu"
  currencySym String    // "€", "£", "$"
  basePrice   Float     // temel paket bedeli
  govFee      Float     @default(0) // resmi harç
  days        Int       // ortalama kuruluş süresi (gün)
  remote      Boolean   @default(true) // uzaktan kurulabiliyor mu
  taxNote     String?   // vergi notu, örn "%9 kurumlar vergisi"
  published   Boolean   @default(true)
  order       Int       @default(0)
  services    Service[]
  configs     CompanyConfiguration[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------- EK HİZMETLER (her ülkeye bağlı) ----------
model Service {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  slug        String   // "address", "bank", "vat" ...
  groupName   String   // "Adres ve operasyon", "Banka ve ödeme" ...
  name        String
  description String?
  price       Float
  yearly      Boolean  @default(false) // yıllık tekrarlanan hizmet
  recurring   Boolean  @default(false)
  term        String?  // "6 ay" gibi
  renewPrice  Float?
  required    Boolean  @default(false)
  days        Int?     // ek süre gerektiriyorsa
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- FİYATLANDIRMA YAPILANDIRICISI ÜZERİNDEN GELEN TEKLİFLER ----------
model CompanyConfiguration {
  id               String   @id @default(cuid())
  countryId        String?
  country          Country? @relation(fields: [countryId], references: [id])
  selectedServices Json     // seçilen hizmetlerin id/isim/fiyat listesi
  totalPrice       Float
  secondYearPrice  Float    @default(0)
  discountApplied  Float    @default(0)
  customerName     String
  customerEmail    String
  customerPhone    String
  activityNote     String?
  timeline         String?  // "Hemen", "1 ay içinde" ...
  status           String   @default("yeni") // yeni | iletisimde | tamamlandi | iptal
  pdfPath          String?  // oluşturulan teklif PDF'inin sunucudaki yolu
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------- İLETİŞİM FORMU / GENEL LEAD'LER ----------
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String?
  source    String   @default("iletisim") // iletisim | wipo | rehber | diger
  status    String   @default("yeni") // yeni | iletisimde | kapandi
  createdAt DateTime @default(now())
}

// ---------- MARKA TESCİL / WIPO BAŞVURULARI ----------
model TrademarkApplication {
  id              String   @id @default(cuid())
  brandName       String
  applicantName   String
  email           String
  phone           String
  country         String   @default("Türkiye") // TR, WIPO/Uluslararası vb.
  niceClasses     String?  // sınıf/mal-hizmet açıklaması
  applicationType String   @default("ulusal") // ulusal | wipo
  status          String   @default("basvuru-alindi")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- REHBER / BLOG YAZILARI ----------
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  contentHtml String    @db.Text
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------- SIK SORULAN SORULAR (sayfa bazlı) ----------
model FaqItem {
  id       String @id @default(cuid())
  page     String // "anasayfa", "marka-tescili", "fiyatlandirma" ...
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

// ---------- ESNEK SAYFA İÇERİĞİ (hero metni, istatistik, referans gibi
// sık değişen ama tablo açmayı gerektirmeyen bloklar için) ----------
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique // "anasayfa", "marka-tescili" ...
  data      Json     // { hero: {...}, stats: [...], reviews: [...] }
  updatedAt DateTime @updatedAt
}

// =====================================================================
//  MARKA İZLEME PLATFORMU  (/izleme)
//  Ayrıntılı açıklama: docs/marka-izleme/MIMARI.md
//  Tarih alanları: gün bazlı tarihler UTC 00:00 olarak saklanır
//  (ör. bülten yayın tarihi 2026-11-03 → 2026-11-03T00:00:00Z).
// =====================================================================

// ---------- MÜVEKKİLLER ----------
model Client {
  id            String        @id @default(cuid())
  name          String                          // firma / kişi adı
  type          String        @default("kurumsal") // kurumsal | bireysel
  contactName   String?
  email         String?
  phone         String?
  taxNo         String?
  city          String?
  notes         String?       @db.Text
  portalToken   String?       @unique           // müşteri portalı bağlantısı (rastgele, tahmin edilemez)
  portalEnabled Boolean       @default(true)
  notifyEmail   Boolean       @default(true)    // eşleşmeler müşteriye e-postayla bildirilebilir mi
  source        String        @default("manuel") // manuel | site-formu | ice-aktarim
  leadId        String?
  active        Boolean       @default(true)
  kvkkConsentAt DateTime?                       // KVKK aydınlatma/açık rıza onayı
  marks         WatchedMark[]
  oppositions   Opposition[]
  deadlines     Deadline[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active])
}

// ---------- İZLENEN MARKALAR (portföy) ----------
model WatchedMark {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String                       // marka ibaresi (540)
  nameNorm         String        @default("")   // normalize edilmiş ibare (lib/izleme/text.normalize)
  classes          Int[]                        // Nice sınıfları (511)
  viennaCodes      String[]                     // şekil unsurları: Viyana kodları (531), ör. "26.04.01"
  goods            String?       @db.Text       // mal/hizmet listesi (isteğe bağlı)
  applicationNo    String?                      // TÜRKPATENT başvuru no, ör. 2019/123456
  registrationNo   String?
  applicationDate  DateTime?                    // koruma süresi başlangıcı (yenileme hesabı)
  registrationDate DateTime?
  markStatus       String        @default("tescilli") // basvuru | yayinda | tescilli | itirazli | reddedildi | sona-erdi
  logoUrl          String?
  watchType        String        @default("kelime") // kelime | kelime-sekil | sekil
  threshold        Int?                         // marka bazlı eşik (boşsa genel ayar)
  watchRelated     Boolean       @default(true) // ilişkili sınıfları da izle
  excludeTerms     String[]                     // yanlış alarm üreten ibareler (eşleşme üretmez)
  ownerAliases     String[]                     // müvekkilin kendi başvurularını elemek için sahip adları
  active           Boolean       @default(true)
  pendingApproval  Boolean       @default(false) // site formundan gelen, onay bekleyen talep
  watchStart       DateTime      @default(now())
  watchEnd         DateTime?                    // izleme sözleşmesi bitişi
  notes            String?       @db.Text
  matches          WatchMatch[]
  deadlines        Deadline[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([clientId])
  @@index([active])
}

// ---------- RESMİ MARKA BÜLTENLERİ ----------
model Bulletin {
  id                 String         @id @default(cuid())
  type               String         @default("marka") // marka (ileride: tasarim, patent)
  number             String         @unique           // "503" ya da "2026/21"
  publishDate        DateTime                          // yayın tarihi (UTC 00:00)
  oppositionDeadline DateTime                          // SMK m.18: yayından itibaren 2 ay (+ tatil kaydırması)
  sourceUrl          String?
  fileName           String?
  filePath           String?                           // sunucuda saklanan dosya (kendi sunucunuzda çalışırken)
  fileHash           String?
  fileSize           Int?
  pageCount          Int?
  pagesDone          Int            @default(0)        // kaldığı yerden devam için
  recordCount        Int            @default(0)
  parseWarnings      Int            @default(0)
  status             String         @default("bekliyor") // bekliyor | indiriliyor | ayristiriliyor | taraniyor | tamamlandi | hata
  progress           Int            @default(0)        // 0-100
  error              String?        @db.Text
  scannedAt          DateTime?
  matchCount         Int            @default(0)
  notes              String?
  marks              BulletinMark[]
  matches            WatchMatch[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([publishDate])
}

// ---------- BÜLTENDE YAYIMLANAN BAŞVURULAR ----------
model BulletinMark {
  id              String       @id @default(cuid())
  bulletinId      String
  bulletin        Bulletin     @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  applicationNo   String                       // (210)
  applicationDate DateTime?                    // (220)
  markText        String       @default("")    // (540) ibare; salt şekil markada boş
  markNorm        String       @default("")    // normalize ibare (arama/trigram)
  markPhon        String       @default("")    // fonetik anahtar
  markType        String?                      // kelime | sekil | kelime-sekil | diger
  classes         Int[]                        // (511)
  goods           String?      @db.Text        // mal ve hizmet metni
  viennaCodes     String[]                     // (531)
  colors          String?                      // (591)
  priority        String?                      // (300)
  owner           String?                      // (731)
  ownerAddress    String?
  attorney        String?                      // (740)
  pageNo          Int?                         // bültendeki sayfa
  rawText         String?      @db.Text        // ayrıştırılan ham metin (doğrulama için)
  matches         WatchMatch[]
  createdAt       DateTime     @default(now())

  @@unique([bulletinId, applicationNo])
  @@index([applicationNo])
  @@index([markNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "BulletinMark_markNorm_trgm_idx")
  @@index([markPhon(ops: raw("gin_trgm_ops"))], type: Gin, map: "BulletinMark_markPhon_trgm_idx")
}

// ---------- EŞLEŞMELER (inceleme kuyruğu) ----------
model WatchMatch {
  id               String       @id @default(cuid())
  watchedMarkId    String
  watchedMark      WatchedMark  @relation(fields: [watchedMarkId], references: [id], onDelete: Cascade)
  bulletinMarkId   String
  bulletinMark     BulletinMark @relation(fields: [bulletinMarkId], references: [id], onDelete: Cascade)
  bulletinId       String
  bulletin         Bulletin     @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  score            Int                          // 0-100 toplam risk
  nameScore        Int                          // 0-100 ibare benzerliği
  classScore       Int                          // 0-100 sınıf örtüşmesi
  level            String                       // yuksek | orta | dusuk
  reasons          Json                         // ["Okunuşu aynı", "Ortak sınıf: 3", ...]
  sharedClasses    Int[]
  status           String       @default("yeni") // yeni | inceleniyor | ilgisiz | musteriye-bildirildi | itiraz-edilecek | itiraz-edilmeyecek | itiraz-edildi
  clientDecision   String?                      // itiraz-istiyor | istemiyor
  clientDecisionAt DateTime?
  clientNote       String?      @db.Text
  assignee         String?                      // personel e-postası
  note             String?      @db.Text
  reviewedAt       DateTime?
  reviewedBy       String?
  notifiedAt       DateTime?
  deadline         DateTime                     // itiraz son günü (bültenden)
  opposition       Opposition?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([watchedMarkId, bulletinMarkId])
  @@index([status])
  @@index([bulletinId])
  @@index([deadline])
}

// ---------- İTİRAZ DOSYALARI ----------
model Opposition {
  id           String      @id @default(cuid())
  matchId      String?     @unique
  match        WatchMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetAppNo  String                      // itiraz edilen başvuru no
  targetMark   String
  targetOwner  String?
  bulletinNo   String?
  basisMarks   String?     @db.Text        // dayanak markalar / haklar
  grounds      String[]                    // SMK gerekçeleri: "6/1", "6/3", "6/4", "6/5", "6/6", "6/7", "6/9", "5/1-b" ...
  deadline     DateTime                    // itiraz son günü
  filedAt      DateTime?
  officeRefNo  String?                     // EPATS evrak numarası
  officialFee  Float?                      // resmi harç
  serviceFee   Float?                      // vekil ücreti
  status       String      @default("hazirlaniyor") // hazirlaniyor | dosyalandi | karsi-gorus | karar-bekleniyor | kabul | kismen-kabul | ret | yidk-itiraz | dava | geri-cekildi
  decisionDate DateTime?
  outcomeNote  String?     @db.Text
  notes        String?     @db.Text
  deadlines    Deadline[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

// ---------- SÜRELER / HATIRLATMALAR ----------
model Deadline {
  id             String       @id @default(cuid())
  kind           String                        // itiraz | karsi-gorus | yidk-itiraz | dava | yenileme | yenileme-ek-sure | kullanim-ispati | izleme-bitis | diger
  title          String
  dueDate        DateTime
  status         String       @default("acik") // acik | tamamlandi | iptal
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  watchedMarkId  String?
  watchedMark    WatchedMark? @relation(fields: [watchedMarkId], references: [id], onDelete: Cascade)
  oppositionId   String?
  opposition     Opposition?  @relation(fields: [oppositionId], references: [id], onDelete: Cascade)
  matchId        String?
  remindDays     Int[]        @default([30, 14, 7, 3, 1])
  lastRemindedAt DateTime?
  completedAt    DateTime?
  note           String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([dueDate, status])
}

// ---------- BİLDİRİM KAYITLARI ----------
model Notification {
  id        String    @id @default(cuid())
  channel   String                         // email | whatsapp | panel
  kind      String                         // eslesme-bildirimi | gunluk-ozet | sure-hatirlatma | portal-karar | yeni-bulten | site-talebi
  recipient String?
  subject   String?
  body      String?   @db.Text
  status    String    @default("bekliyor") // bekliyor | gonderildi | hata | atlandi
  error     String?   @db.Text
  clientId  String?
  matchId   String?
  readAt    DateTime?                      // panel bildirimleri için
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// ---------- İŞLEM GEÇMİŞİ ----------
model Activity {
  id        String   @id @default(cuid())
  actor     String                         // personel e-postası | "sistem" | "müşteri:<clientId>"
  action    String                         // ör. "eslesme.durum", "bulten.ice-aktar"
  entity    String                         // client | mark | bulletin | match | opposition | deadline | setting
  entityId  String?
  summary   String                         // insan okunur açıklama
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------- ARKA PLAN İŞLERİ ----------
model Job {
  id         String    @id @default(cuid())
  kind       String                        // bulten-kontrol | bulten-indir | bulten-ayristir | bulten-tara | hatirlatma | gunluk-ozet
  status     String    @default("bekliyor") // bekliyor | calisiyor | tamamlandi | hata
  bulletinId String?
  payload    Json?
  progress   Int       @default(0)
  message    String?
  error      String?   @db.Text
  attempts   Int       @default(0)
  lockedAt   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// ---------- PLATFORM AYARLARI (anahtar → JSON) ----------
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
